{
  "name": "supercal",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.4",
  "engines": {
    "bun": "1.3.4"
  },
  "scripts": {
    "dev": "bun --watch apps/daemon/src/main.ts",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck",
    "test": "bun test ./apps/daemon ./packages && bun run --cwd apps/web test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:egress": "bun test ./packages/providers/test/transport",
    "test:radicale": "bun test --timeout 120000 ./apps/daemon/test/radicale.e2e.ts",
    "test:dav-clients": "bun test --timeout 300000 ./apps/daemon/test/dav/clients/clients.e2e.ts",
    "check": "bun run typecheck && bun run test && bun run check:api-client",
    "migrate": "bun packages/db/scripts/migrate.ts",
    "api:spec": "bun apps/daemon/scripts/api-spec.ts",
    "api:client": "bun run --cwd packages/api-client generate",
    "check:api-client": "bun run api:spec && bun run api:client && git diff --exit-code -- packages/api-client/openapi.json packages/api-client/src/schema.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "typescript": "5.9.3"
  }
}
