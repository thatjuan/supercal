{
  "name": "supercal",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.4",
  "engines": {
    "bun": "1.3.4"
  },
  "scripts": {
    "dev": "bun --watch apps/daemon/src/main.ts",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck",
    "test": "bun test ./apps ./packages",
    "test:egress": "bun test ./packages/providers/test/transport",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "typescript": "5.9.3"
  }
}
