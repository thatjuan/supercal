{
  "name": "@supercal/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./unsafe-db": "./src/unsafe-db.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "migrate": "bun scripts/migrate.ts",
    "db:generate": "drizzle-kit generate && bun scripts/embed-migrations.ts",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
